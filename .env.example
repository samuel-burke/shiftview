# Copy to .env.local and fill in. Never commit real values.
# Names only: see README "Set environment variables" for what each one enables.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 64 hex characters (openssl rand -hex 32). Losing it makes stored messages unreadable.
MESSAGE_ENCRYPTION_KEY=

# Required in a Vercel production build (lib/production-env.ts); optional locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Optional
# Defaults to mailto:noreply@shiftview.app
VAPID_SUBJECT=
# Server-only. Anyone holding the URL can post to the channel.
SLACK_WEBHOOK_URL=

# Playwright only. Never set in a deployment (a production build fails if it is set).
# E2E_BYPASS_AUTH=1
